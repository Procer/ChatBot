# CONFIGURACIÓN LLM (GOOGLE GEMINI)
GOOGLE_API_KEY=tu_google_api_key_aqui

# CONFIGURACIÓN LANGSMITH (OBSERVABILIDAD)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY=tu_langsmith_key_aqui
LANGSMITH_PROJECT="chatbot-whatsapp"

# CONFIGURACIÓN EVOLUTION API
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY="422ecce3-6b71-4603-9d91-4e4b52b2b64d"
EVOLUTION_INSTANCE_NAME="chatbot_whatsapp"

# CONFIGURACIÓN SERVIDOR (FASTAPI)
PORT=8000

# MODO DE OPERACIÓN (local / production)
ENVIRONMENT=local

# MODO TELEGRAM (polling / webhook)
TELEGRAM_MODE=polling

# BIBLIOTECA DE DOCUMENTOS - GOOGLE DRIVE
# Clave Fernet para encriptar en DB los refresh tokens de Drive de cada cliente
# y el Client Secret de la app OAuth. Generarla una vez con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GDRIVE_TOKEN_ENCRYPTION_KEY=

# El Client ID / Client Secret de la app OAuth de Google (una sola app, compartida por
# todos los clientes/tenants) ya NO se configuran acá: se cargan una vez desde el panel
# Super Admin (/super-admin > Integraciones Globales). Estas variables quedan solo como
# fallback para instalaciones viejas que ya las tenían seteadas por .env.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
