# CONFIGURACIÓN LLM (GOOGLE GEMINI)
GOOGLE_API_KEY=tu_google_api_key_aqui

# CONFIGURACIÓN LANGSMITH (OBSERVABILIDAD)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY=tu_langsmith_key_aqui
LANGSMITH_PROJECT="chatbot-whatsapp"

# CONFIGURACIÓN EVOLUTION API
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY="422ecce3-6b71-4603-9d91-4e4b52b2b64d"
EVOLUTION_INSTANCE_NAME="chatbot_whatsapp"

# CONFIGURACIÓN SERVIDOR (FASTAPI)
PORT=8000

# MODO DE OPERACIÓN (local / production)
ENVIRONMENT=local

# MODO TELEGRAM (polling / webhook)
TELEGRAM_MODE=polling

# BIBLIOTECA DE DOCUMENTOS - GOOGLE DRIVE
# Clave Fernet para encriptar en DB la clave JSON de la cuenta de servicio de Drive de
# cada cliente. Generarla una vez con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GDRIVE_TOKEN_ENCRYPTION_KEY=

# La cuenta de servicio de Google (una por cliente/tenant, dentro de un único proyecto de
# Google Cloud propio) se crea en Google Cloud Console y su clave JSON se carga por cliente
# desde el panel Super Admin (/super-admin > ícono de engranaje del cliente > "Google Drive").
# No hay variables de entorno para esto: cada tenant tiene su propia clave, guardada
# encriptada en ClientSettings.gdrive_service_account_json_encrypted.
